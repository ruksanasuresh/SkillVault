PORT=3000
JWT_SECRET=change-this-to-a-long-random-string

# Optional — set ONE of these to upgrade grade extraction, certificate
# content verification, and recommendations from the built-in heuristics
# to real LLM calls. Leave both unset and everything still works, just
# using the deterministic engines.
#
# Gemini has a genuine free tier (no billing required) — get a key at
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.1-flash-lite
#
# Claude has no permanent free tier (pay-as-you-go, cheap for this app's
# usage) — get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
#
# If both keys above are set, Gemini is used by default (it's free).
# Force one explicitly with:
# LLM_PROVIDER=gemini
